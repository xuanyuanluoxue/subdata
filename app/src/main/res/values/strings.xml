    <string name="switch_enabled_title">启用重定向</string>
    <string name="switch_enabled_desc">关闭后模块对该 App 完全不生效，直接使用原始数据目录。</string>
    <string name="switch_clone_title">首次运行克隆数据</string>
    <string name="switch_clone_desc">新 slot 第一次使用时，从默认数据目录复制一份冷数据（跳过 lib / cache）。</string>
    <string name="switch_external_title">重定向外部存储</string>
    <string name="switch_external_desc">连 /sdcard/Android/data/包名 一起重定向。部分 App 的外部缓存会因此翻倍。</string>
    <string name="switch_file_paths_title">兜底 hook File 构造</string>
    <string name="switch_file_paths_desc">拦截 App 自己拼的绝对路径（new File(\"/data/data/…\")）。关掉可减少全局 hook 开销。</string>
    <string name="switch_data_dir_title">hook getDataDir（高风险）</string>
    <string name="switch_data_dir_desc">把整棵数据树的根也重定向，覆盖最彻底，但会波及 App 里所有依赖 getDataDir 的第三方 SDK，出问题优先关它。</string>
    <string name="switch_island_title">超级岛提示</string>
    <string name="switch_island_desc">非主槽时在超级岛提示「当前处于副本数据」；主槽（默认 a）不发通知。学习通自己没开通知权限时会静默失败。</string>
    <string name="switch_write_ok">已保存，强制停止目标 App 后生效</string>
    <string name="switch_write_fail">写入失败：%1$s</string>

    <string name="danger_title">删除 subdata 目录（回滚）</string>
    <string name="danger_desc">只会删除 /data/data/包名/subdata（slot 副本、日志、配置）。不会动原始数据，删除后 App 立即回到原数据。</string>
    <string name="danger_button">删除 subdata 目录</string>
    <string name="danger_confirm1_title">确认删除 subdata 目录？</string>
    <string name="danger_confirm1_msg">将删除 %1$s 下的 subdata 目录。\n\n· 只删副本与日志，不会动原始数据\n· 删除后该 App 立即回到原始数据\n· 建议先取消 LSPosed 里对本模块的勾选</string>
    <string name="danger_confirm1_yes">继续</string>
    <string name="danger_confirm2_title">再次确认</string>
    <string name="danger_confirm2_msg">这一步不可撤销。确定要删除 %1$s 吗？</string>
    <string name="danger_confirm2_yes">确定删除</string>
    <string name="danger_deleted">已删除</string>
    <string name="danger_delete_fail">删除失败：%1$s</string>

    <string name="about_principle">原理：LSPosed 注入目标 App 进程，把 ContextImpl 的 getDataDir / getFilesDir / getCacheDir / getDatabasePath / getSharedPreferencesPath 等重定向到 /data/data/包名/subdata/slot/。同一个 APK、同一个 uid，用不同 slot 即拥有互不干扰的数据。</string>
    <string name="about_risk">风险提示：本模块属于 Beta。它只在被注入的 App 进程内改路径，不写系统分区、不改 APK、不挂载分区；但 root 环境任何模块都可能影响系统稳定性，出问题先在 LSPosed 里取消勾选本模块。</string>
    <string name="about_rollback">回滚：取消 LSPosed 勾选 → App 立即回到原始数据；需要彻底清理时用上面的「删除 subdata 目录」。</string>

